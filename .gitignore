# Dependencies
node_modules/

# Production build output
dist/
dist-ssr/
build/
coverage/

# Environment files and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Logs and package manager debug files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local caches and temporary files
.cache/
.vite/
*.local
*.tmp
*.temp

# Local backups - do not publish backup folders
backup-*/
frontend-backup-*/
.gitignore.backup

# Editor and operating system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

src/components/*.backup
